# ==================================================
# Project-generated files
# ==================================================

# --------------------------------------------------
# hack/model/output
# --------------------------------------------------

# Ignore generated files
hack/model/output/**

# Allow Git to traverse subdirectories
!hack/model/output/**/

# Preserve package initialisation files and placeholder
!hack/model/output/**/__init__.py
!hack/model/output/.gitkeep

# --------------------------------------------------
# docs/descriptions
# --------------------------------------------------

# Ignore generated files
docs/descriptions/**

# Allow Git to traverse subdirectories
!docs/descriptions/**/

# Preserve package initialisation files and placeholder
!docs/descriptions/**/__init__.py
!docs/descriptions/.gitkeep


# --------------------------------------------------
# src/method_input_files
# --------------------------------------------------

# Ignore generated files
src/method_input_files/**

# Allow Git to traverse subdirectories
!src/method_input_files/**/

# Preserve package initialisation files and placeholder
!src/method_input_files/**/__init__.py
!src/method_input_files/.gitkeep


# --------------------------------------------------
# src/output
# --------------------------------------------------

# Ignore generated files
src/output/**

# Allow Git to traverse subdirectories
!src/output/**/

# Preserve package initialisation files and placeholder
!src/output/**/__init__.py
!src/output/.gitkeep


# --------------------------------------------------
# src/data/study_case_files
# --------------------------------------------------

# Ignore generated files
src/data/study_case_files/**

# Allow Git to traverse subdirectories
!src/data/study_case_files/**/

# Preserve package initialisation files
!src/data/study_case_files/**/__init__.py

# Add this if the directory has a placeholder:
# !src/data/study_case_files/.gitkeep


# ==================================================
# General exceptions
# ==================================================

# Never ignore Python package initialisation files
# when their parent directories are accessible to Git
!**/__init__.py